{
  "name": "dsh-pal-channel",
  "version": "0.1.0",
  "description": "在 DSH 界面里一键切换公网入口：国内 frp 与 Cloudflare 隧道二选一。只改 remote-web-ui 的配置，不 import 也不 patch 它的代码，上游更新冲不掉本功能。",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "Apache-2.0"
}
