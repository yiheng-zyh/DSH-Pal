<?xml version="1.0" encoding="utf-8"?><data-extraction-rules>
<cloud-backup>
<exclude domain="file" path="tailscale/" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_secrets_tailscale.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_index_tailscale.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_secrets_wireguard.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_index_wireguard.xml" />
<exclude domain="sharedpref" path="dsh_overlay_draft.xml" />
<!-- 实验功能「对话本地缓存」：对话正文（含工具输出）属敏感内容，绝不进云备份。 -->
<exclude domain="file" path="chat-archive/" />
</cloud-backup>
<device-transfer>
<exclude domain="file" path="tailscale/" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_secrets_tailscale.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_index_tailscale.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_secrets_wireguard.xml" />
<exclude domain="sharedpref" path="dsh_mobile_vpn_index_wireguard.xml" />
<exclude domain="sharedpref" path="dsh_overlay_draft.xml" />
<!-- 实验功能「对话本地缓存」：换机迁移也不带走对话正文。 -->
<exclude domain="file" path="chat-archive/" />
</device-transfer>
</data-extraction-rules>
